{
    "name": "prompt-compiler",
    "version": "1.0.0",
    "description": "Transform underspecified inputs into optimized LLM prompts from your menu bar",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "package": "electron-builder --mac",
        "package:dmg": "electron-builder --mac dmg"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.promptcompiler.app",
        "productName": "Prompt Compiler",
        "mac": {
            "category": "public.app-category.developer-tools",
            "icon": "assets/icon.icns",
            "target": ["dmg", "zip"]
        },
        "files": [
            "electron/**/*",
            "src/**/*",
            "popup.html",
            "popup.css",
            "assets/**/*"
        ]
    }
}
